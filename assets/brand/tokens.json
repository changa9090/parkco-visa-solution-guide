{
  "$meta": {
    "name": "Park & Co Lawyers — Brand System 2026",
    "version": "1.0.0",
    "source": "Canva Brand Foundations Phase 1 + newhomepage-01 + immigration-law (captured 2026-10-06)",
    "status": "Phase 1 tokens. Component library not yet produced.",
    "contrastBase": "ivory #F1EDE6 (as stated in the Canva spec)"
  },
  "color": {
    "brand": {
      "burgundy":       { "value": "#7A1F2B", "role": "Primary. CTA, links, icons, umbrella brand colour" },
      "oxblood":        { "value": "#530009", "role": "Pressed / hover-dark state of burgundy" },
      "burgundy-wash":  { "value": "#F2E4E5", "role": "Tint surface, selected tag, soft highlight" },
      "burgundy-light": { "value": "#D9A7AD", "role": "Burgundy-family text or rule on dark (charcoal / ink-deep) backgrounds" }
    },
    "neutral": {
      "charcoal":      { "value": "#2E2E2E", "role": "Primary text; dark stat band background" },
      "charcoal-soft": { "value": "#5A5654", "role": "Secondary text" },
      "muted":         { "value": "#8A857D", "role": "Captions, meta, placeholder. Large text or non-essential only (AA-large)" },
      "ink-deep":      { "value": "#1A1211", "role": "Dark hero background (practice-page hero)" },
      "on-dark-muted": { "value": "#CFC9BF", "role": "Secondary text on charcoal / ink-deep" },
      "paper":         { "value": "#FCFAF6", "role": "Default page background" },
      "ivory":         { "value": "#F1EDE6", "role": "Section band, warm surface, nav sub-bar" },
      "sand":          { "value": "#EFE3D3", "role": "Hero band background (homepage)" },
      "stone":         { "value": "#E4E2DF", "role": "Cool-neutral band (practice nav, testimonial band)" },
      "white":         { "value": "#FFFFFF", "role": "Card surface on ivory / stone bands" },
      "line":          { "value": "#E7E0D3", "role": "Default 1px border / divider" },
      "line-strong":   { "value": "#DED6C8", "role": "Input border, emphasised divider" }
    },
    "practice": {
      "personal-injury": { "value": "#7A1F2B", "name": "Burgundy",  "ko": "개인상해" },
      "immigration":     { "value": "#1F5A5E", "name": "Deep Teal", "ko": "이민법" },
      "employment":      { "value": "#6B4A1F", "name": "Bronze",    "ko": "고용법" },
      "family":          { "value": "#4A3A5A", "name": "Deep Plum", "ko": "가족법" }
    },
    "semantic": {
      "success": { "value": "#2E6B4F" },
      "warning": { "value": "#B67A1E" },
      "error":   { "value": "#B23A2E" }
    }
  },
  "font": {
    "family": {
      "display-serif":    { "value": "'Cormorant Garamond', Georgia, serif", "use": "Logo lock-up, pull quotes, serif moments. Never body." },
      "sans":             { "value": "'Manrope', system-ui, sans-serif", "use": "Latin headlines, nav, buttons, body, captions. Also all numerals and symbols." },
      "ko-serif":         { "value": "'Gowun Batang', serif", "use": "Korean quotes and Korean slogan. Never body." },
      "ko-sans":          { "value": "'Pretendard', 'Manrope', system-ui, sans-serif", "use": "Korean headlines, nav, buttons, body, captions." }
    },
    "scale": {
      "en": {
        "h1":       { "family": "sans", "weight": 800, "size": "56px", "lineHeight": 1.04, "letterSpacing": "-0.025em" },
        "h2":       { "family": "sans", "weight": 800, "size": "40px", "lineHeight": 1.15, "letterSpacing": "-0.02em" },
        "h3":       { "family": "sans", "weight": 700, "size": "28px", "lineHeight": 1.25 },
        "h4":       { "family": "sans", "weight": 700, "size": "20px", "lineHeight": 1.35 },
        "body-lg":  { "family": "sans", "weight": 400, "size": "18px", "lineHeight": 1.6 },
        "body":     { "family": "sans", "weight": 400, "size": "16px", "lineHeight": 1.65, "note": "minimum body size" },
        "small":    { "family": "sans", "weight": 500, "size": "14px" },
        "overline": { "family": "sans", "weight": 700, "size": "13px", "letterSpacing": "0.12em", "textTransform": "uppercase" }
      },
      "ko": {
        "h1":       { "family": "ko-sans", "weight": 900, "size": "52px", "lineHeight": 1.12, "letterSpacing": "-0.03em" },
        "h2":       { "family": "ko-sans", "weight": 800, "size": "38px", "lineHeight": 1.25, "letterSpacing": "-0.025em" },
        "h3":       { "family": "ko-sans", "weight": 700, "size": "26px", "lineHeight": 1.35 },
        "body-lg":  { "family": "ko-sans", "weight": 400, "size": "18px", "lineHeight": 1.75 },
        "body":     { "family": "ko-sans", "weight": 400, "size": "16px", "lineHeight": 1.8, "note": "minimum body size" },
        "small":    { "family": "ko-sans", "weight": 500, "size": "14px", "lineHeight": 1.7 },
        "overline": { "family": "ko-sans", "weight": 700, "size": "13px", "note": "no letter-spacing expansion, no uppercase" }
      }
    }
  },
  "space": {
    "1": "4px", "2": "8px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px",
    "ko-paragraph-extra": "4px",
    "ko-control-padding-y-extra": "2px"
  },
  "grid": { "columns": 12, "maxWidth": "1200px", "gutter": "24px", "marginDesktop": "48px" },
  "radius": {
    "sm":   { "value": "2px",   "use": "chips" },
    "md":   { "value": "6px",   "use": "buttons, inputs; Korean tags" },
    "lg":   { "value": "14px",  "use": "cards" },
    "pill": { "value": "999px", "use": "Latin tags, avatars" }
  },
  "shadow": {
    "1": { "value": "0 1px 2px rgba(46, 30, 20, 0.08)",   "use": "rest; default for Korean cards" },
    "2": { "value": "0 6px 18px rgba(46, 30, 20, 0.10)",  "use": "card" },
    "3": { "value": "0 18px 44px rgba(46, 30, 20, 0.16)", "use": "overlay" },
    "cta": { "value": "0 8px 20px rgba(122, 31, 43, 0.28)", "use": "primary CTA on dark hero (observed on immigration-law page)" }
  },
  "icon": { "style": "outline, no fill", "stroke": "1.7px", "cap": "round", "join": "round", "grid": "24px", "sizes": [24, 32, 48], "color": "burgundy; white when inverted" },
  "voice": {
    "slogan-en": "You focus on life, we'll handle the law.",
    "slogan-ko": "삶에 집중하세요, 법률은 저희가 맡겠습니다."
  }
}
